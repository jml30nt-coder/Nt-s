  const abrirDB = () => new Promise((ok, no) => { const r = indexedDB.open('nts', 1); r.onupgradeneeded = () => r.result.createObjectStore('kv'); r.onsuccess = () => ok(r.result); r.onerror = () => no(r.error); });
  const kvGet = async k => { try{ const d = await abrirDB(); const v = await new Promise(ok => { const q = d.transaction('kv').objectStore('kv').get(k); q.onsuccess = () => ok(q.result == null ? null : q.result); q.onerror = () => ok(null); }); d.close(); return v; }catch(e){ return null; } };
  const kvSet = async (k, v) => { try{ const d = await abrirDB(); await new Promise(ok => { const t = d.transaction('kv', 'readwrite'); t.objectStore('kv').put(v, k); t.oncomplete = ok; t.onerror = ok; }); d.close(); }catch(e){} };
  const mostrar = async buf => { const html = new TextDecoder().decode(buf); await kvSet('app:cascaron', JSON.stringify(CASCARON)); document.open(); document.write(html); document.close(); };
  const descifrar = key => crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(P.iv) }, key, b64(P.ct));
  const entrar = async () => {
    const c = $('clave').value; if(!c) return;
    $('msg').textContent = ''; $('entrar').disabled = true; $('entrar').textContent = 'Abriendo…';
    try{
      const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(c), 'PBKDF2', false, ['deriveKey']);
      const key = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: b64(P.salt), iterations: P.it, hash: 'SHA-256' }, base, { name: 'AES-GCM', length: 256 }, true, ['decrypt']);
      let buf;
      try{ buf = await descifrar(key); }
      catch(e){ $('msg').textContent = 'Contraseña incorrecta'; $('entrar').disabled = false; $('entrar').textContent = 'Entrar'; return; }
      if($('recordar').checked){ const raw = new Uint8Array(await crypto.subtle.exportKey('raw', key)); await kvSet('app:llave', JSON.stringify({ salt: P.salt, k: aB64(raw) })); }
      await mostrar(buf);
    }catch(e){ $('msg').textContent = 'Error: ' + e.message; $('entrar').disabled = false; $('entrar').textContent = 'Entrar'; }
  };
  $('entrar').onclick = entrar;
  $('clave').onkeydown = e => { if(e.key === 'Enter') entrar(); };
  (async () => {
    try{
      const g = await kvGet('app:llave');
      if(g){ const o = JSON.parse(g); if(o.salt === P.salt){ const key = await crypto.subtle.importKey('raw', b64(o.k), 'AES-GCM', false, ['decrypt']); return mostrar(await descifrar(key)); } }
    }catch(e){}
    $('caja').hidden = false; $('clave').focus();
  })();
})();
</script></body></html>
